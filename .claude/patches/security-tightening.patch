+  ['git push --mirror origin', onTicket],
+  ['git push --all origin', onTicket],
+  ['git push --prune origin', onTicket],
+  // force/delete via abbreviations, other spellings of git, config and aliases
+  ['git push --force-w origin x', onTicket],
+  ['git push --forc origin x', onTicket],
+  ['git push --dele origin x', onTicket],
+  ['/usr/bin/git push --force origin x', onTicket],
+  ['"git" push --force origin x', onTicket],
+  ['git.exe push -f origin x', onTicket],
+  ['git -c remote.origin.push=+refs/heads/*:refs/heads/main push', onTicket],
+  ['git -c alias.p=push p --force origin x', onTicket],
+  ['git -c core.hooksPath=/dev/null commit -m x', onTicket],
+  ['git config alias.p "push --force"', onTicket],
+  ['git config core.hooksPath /tmp/nohooks', onTicket],
+  ['git config --global url.https://evil.example/.insteadOf https://github.com/', onTicket],
+  ['git checkout -f main', onTicket],
+  ['git checkout --force main', onTicket],
+  ['git switch --discard-changes main', onTicket],
+  ['git switch -f main', onTicket],
+  // writing guardrail files after cd, or through interpreters and .NET
+  ['cd .claude && echo {} > settings.json', onTicket],
+  ['cd .claude/hooks; tee guard.mjs < evil.mjs', onTicket],
+  ['Set-Location .claude; Set-Content settings.json "{}"', onTicket],
+  ["perl -pi -e 's/deny/allow/' .claude/settings.json", onTicket],
+  ['python -c "open(\'.claude/settings.json\',\'w\').write(\'{}\')"', onTicket],
+  ["[IO.File]::WriteAllText('.claude/settings.json', '{}')", onTicket],
+  ['echo x > .claude/agents/security-reviewer.md', onTicket],
+  ['cp evil.md .claude/skills/factory-loop/SKILL.md', onTicket],
+  ['echo x > .claude/skills/ticket-screen/scripts/screen.mjs', onTicket],
+  // deletes by other names
+  ['/usr/bin/rm -rf todo', onTicket],
+  ['Remove-Item -Rec todo', onTicket],
+  ['Get-ChildItem todo -Recurse | Remove-Item', onTicket],
+  ["[IO.Directory]::Delete('todo', $true)", onTicket],
+  ['node -e "require(\'fs\').promises.rm(\'todo\', {recursive: true})"', onTicket],
+  ['find . -name "*.js" | xargs rm', onTicket],
+  ['pwsh -Command "Remove-Item todo -Recurse"', onTicket],
+  // GitHub
+  ['gh issue transfer 5 other/repo', onTicket],
+  ['gh repo archive o/r --yes', onTicket],
+  ['gh api graphql -f query="mutation { mergePullRequest(input: {pullRequestId: \\"x\\"}) { clientMutationId } }"', onTicket],
+  ['Invoke-RestMethod -Method DELETE https://api.github.com/repos/o/r/git/refs/heads/x', onTicket],
+];
+
+const ASK = [
+  ['git apply fix.patch', onTicket],
+  ['git am 0001-fix.patch', onTicket],
+  ['patch -p1 < fix.patch', onTicket],
+  ['git frobnicate', onTicket], // unknown subcommand: could be an alias
+];
+
+const ALLOW = [
+  // false positives the review reported
+  ['grep "install" .gitignore', onTicket],
+  ['grep -n "rm.*--cached" .claude/hooks/guard-rules.mjs', onTicket],
+  ['git commit -m "docs: never rm -rf, find -delete or push to main"', onTicket],
+  ["git commit -F - <<'EOF'\nGuard: blocks find -delete and rm -rf todo\n\nCo-Authored-By: x\nEOF", onTicket],
+  // ordinary work
+  ['git push origin HEAD', onTicket],
+  ['git -C . status', onTicket],
+  ['git config --get user.name', onTicket],
+  ['git config user.email eval@example.com', onTicket],
+  ['cd todo && echo hi > notes.txt', onTicket],
+  ['Get-ChildItem -Recurse todo | Measure-Object', onTicket],
+  ['node .claude/skills/ticket-screen/scripts/screen.mjs --issue 6', onTicket],
+  ['cat .claude/settings.json | node -e "process.stdin.pipe(process.stdout)"', onTicket],
+  ['gh api graphql -f query="query { viewer { login } }"', onTicket],
+];
+
+for (const [cmd, ctx] of DENY) test(`deny: ${cmd}`, () => assert.equal(check(cmd, ctx).decision, 'deny', check(cmd, ctx).reason || 'allowed'));
+for (const [cmd, ctx] of ASK) test(`ask: ${cmd}`, () => assert.equal(check(cmd, ctx).decision, 'ask', check(cmd, ctx).reason || 'allowed'));
+for (const [cmd, ctx] of ALLOW) test(`allow: ${cmd}`, () => assert.equal(check(cmd, ctx).decision, 'allow', check(cmd, ctx).reason));
+
+test('a heredoc that feeds a shell is still checked', () => {
+  assert.equal(check("bash <<'EOF'\nrm -rf todo\nEOF", onTicket).decision, 'deny');
+});
diff --git a/.claude/tests/screen-tool-output.test.mjs b/.claude/tests/screen-tool-output.test.mjs
