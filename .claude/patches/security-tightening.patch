+#!/usr/bin/env node
+// PostToolUse hook: screens text that came from outside (GitHub issues/PRs/comments, web pages,
+// ticket scripts) with the ticket screen, and warns the agent in context when it finds a prompt
+// injection or a malicious request. It can't un-show the text; it makes sure the agent reads it
+// as hostile data, and it records the finding in the session for the user.
+import fs from 'node:fs';
+import { screen } from '../skills/ticket-screen/scripts/screen.mjs';
+
+let input = {};
+try {
+  input = JSON.parse(fs.readFileSync(0, 'utf8') || '{}');
+} catch {}
+
+const tool = String(input.tool_name || '');
+const command = String(input.tool_input?.command || '');
+const external = /^mcp__plugin_github|^mcp__github|^WebFetch$|^WebSearch$/.test(tool)
+  || (/^(Bash|PowerShell)$/.test(tool) && /fetch-tickets|pr-feedback|\bgh\s+(issue|pr|api)\b|\b(curl|wget|irm|iwr|Invoke-RestMethod|Invoke-WebRequest)\b/i.test(command)
+    && !/screen\.mjs/.test(command)); // the screen's own report quotes what it found
+
+if (!external) process.exit(0);
+
+const response = input.tool_response;
+const text = typeof response === 'string' ? response : JSON.stringify(response ?? '');
+const { verdict, findings } = screen(text);
+if (verdict === 'SAFE') process.exit(0);
+
+const top = findings.slice(0, 5).map((f) => `- [${f.severity}] ${f.rule}: ${f.why} ("${f.excerpt}")`).join('\n');
+console.log(JSON.stringify({
+  systemMessage: `ticket screen: ${verdict} in ${tool} output (${findings.length} finding(s))`,
+  hookSpecificOutput: {
